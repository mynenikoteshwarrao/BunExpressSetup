modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "CLI Tool"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "cli_test"

[[workflows.workflow]]
name = "CLI Tool"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install commander fs-extra chalk && node cli.js --help"

[[workflows.workflow]]
name = "cli_test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install commander fs-extra chalk"
