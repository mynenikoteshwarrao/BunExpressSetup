{
  "name": "koti",
  "version": "3.0.0",
  "description": "CLI tool to generate Bun API projects with Express, MongoDB, and built-in RBAC. Scaffolds production-ready APIs with authentication, authorization, and security middleware.",
  "main": "dist/cli.js",
  "bin": {
    "koti": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "update-version": "node scripts/update-version.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run update-version && npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "typescript": "^5.3.2",
    "@types/node": "^20.10.0",
    "@types/fs-extra": "^11.0.4",
    "ts-node": "^10.9.1"
  },
  "keywords": [
    "bun",
    "express",
    "mongodb",
    "api",
    "cli",
    "generator",
    "scaffold",
    "boilerplate",
    "javascript",
    "nodejs",
    "rbac",
    "authorization",
    "role-based-access-control",
    "typescript"
  ],
  "author": {
    "name": "mynenikoteshwarrao",
    "email": "mynenikoteshwarrao@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynenikoteshwarrao/BunExpressSetup.git"
  },
  "bugs": {
    "url": "https://github.com/mynenikoteshwarrao/BunExpressSetup/issues"
  },
  "homepage": "https://github.com/mynenikoteshwarrao/BunExpressSetup#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist/",
    "templates/",
    "version.json",
    "README.md",
    "LICENSE"
  ]
}