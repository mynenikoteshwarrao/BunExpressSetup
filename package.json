{
  "name": "koti",
  "version": "2.0.3",
  "description": "⚠️ DEVELOPMENT VERSION: CLI tool to generate Bun API projects with Express and MongoDB. This is an initial development release and may contain errors or bugs. Use at your own discretion.",
  "main": "dist/cli.js",
  "bin": {
    "koti": "./dist/cli.js",
    "koti-mcp": "./dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc",
    "build:mcp": "tsc && echo 'MCP server built at dist/mcp-server.js'",
    "dev": "ts-node src/cli.ts",
    "dev:mcp": "ts-node src/mcp-server.ts",
    "start": "node dist/cli.js",
    "start:mcp": "node dist/mcp-server.js",
    "pack:mcpb": "mcpb pack",
    "update-version": "node scripts/update-version.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run update-version && npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2",
    "vitest": "^4.1.1"
  },
  "keywords": [
    "bun",
    "express",
    "mongodb",
    "api",
    "cli",
    "generator",
    "scaffold",
    "boilerplate",
    "mcp",
    "model-context-protocol",
    "ai-tools",
    "claude",
    "typescript",
    "nodejs"
  ],
  "author": {
    "name": "mynenikoteshwarrao",
    "email": "mynenikoteshwarrao@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynenikoteshwarrao/BunExpressSetup.git"
  },
  "bugs": {
    "url": "https://github.com/mynenikoteshwarrao/BunExpressSetup/issues"
  },
  "homepage": "https://github.com/mynenikoteshwarrao/BunExpressSetup#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist/",
    "templates/",
    "manifest.json",
    "version.json",
    "README.md",
    "LICENSE"
  ]
}
