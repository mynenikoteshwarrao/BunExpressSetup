// Create TypeScript model with schema registry
const createTypescriptModel = async (modelName) => {
  const rl = createReadlineInterface();
  const fields = [];
  
  try {
    // Check if we're in a valid project directory
    const currentPath = process.cwd();
    const packageJsonPath = path.join(currentPath, 'package.json');
    
    if (!await fs.pathExists(packageJsonPath)) {
      console.log(colors.red('❌ This command must be run inside a project directory.'));
      console.log(colors.yellow('💡 Create a new project first: koti new my-project'));
      process.exit(1);
    }

    // Create TypeScript project structure
    const srcPath = path.join(currentPath, 'src');
    await fs.ensureDir(srcPath);
    
    // Create necessary directories
    const directories = ['models', 'schemas', 'controllers', 'services', 'middleware', 'routes', 'types', 'enums'];
    for (const dir of directories) {
      await fs.ensureDir(path.join(srcPath, dir));
    }

    // Create API types file if it doesn't exist
    await createApiTypesFile(srcPath);
    
    // Create utility files
    await createUtilityFiles(srcPath);
    
    // Create enhanced middleware files
    await createEnhancedMiddleware(srcPath);
    
    // Create Swagger configuration
    await createSwaggerConfig(srcPath);

    // Get existing schemas for reference options
    const existingSchemas = await readExistingSchemas(currentPath);
    
    console.log(colors.bold(`\n🏗️  Creating TypeScript model: ${colors.cyan(capitalize(modelName))}\n`));
    console.log(colors.yellow('Available data types:'));
    
    // Show available data types
    availableDataTypes.forEach((type, index) => {
      console.log(`  ${colors.cyan(index + 1)}. ${type.mongoose.padEnd(12)} ${colors.dim('(' + type.typescript + ')')}`);
    });
    
    console.log(colors.yellow('\n📝 Add fields to your model (press Enter without field name to finish):\n'));
    
    let fieldIndex = 1;
    
    while (true) {
      console.log(colors.bold(`--- Field ${fieldIndex} ---`));
      
      // Get field name
      const fieldName = await askQuestion(rl, 'Field name: ');
      if (!fieldName) break;
      
      // Get data type
      const typeChoice = await askQuestion(rl, `Data type (1-${availableDataTypes.length}): `);
      const typeIndex = parseInt(typeChoice) - 1;
      
      if (typeIndex < 0 || typeIndex >= availableDataTypes.length) {
        console.log(colors.red('❌ Invalid data type selection'));
        continue;
      }
      
      const selectedType = availableDataTypes[typeIndex];
      const field = {
        name: fieldName,
        type: selectedType.mongoose,
        typescript: selectedType.typescript
      };
      
      // Handle ObjectId references
      if (selectedType.mongoose === 'ObjectId') {
        if (existingSchemas.length > 0) {
          console.log(colors.yellow('Available schemas for reference:'));
          existingSchemas.forEach((schema, index) => {
            console.log(`  ${index + 1}. ${schema}`);
          });
          
          const refChoice = await askQuestion(rl, `Reference model (1-${existingSchemas.length}) or custom name: `);
          const refIndex = parseInt(refChoice) - 1;
          
          if (refIndex >= 0 && refIndex < existingSchemas.length) {
            field.ref = existingSchemas[refIndex];
          } else {
            field.ref = refChoice;
          }
        } else {
          field.ref = await askQuestion(rl, 'Reference model name: ');
        }
      }
      
      // Handle Array type
      if (selectedType.mongoose === 'Array') {
        const arrayTypeChoice = await askQuestion(rl, `Array element type (1-${availableDataTypes.length}): `);
        const arrayTypeIndex = parseInt(arrayTypeChoice) - 1;
        
        if (arrayTypeIndex >= 0 && arrayTypeIndex < availableDataTypes.length) {
          field.arrayType = availableDataTypes[arrayTypeIndex].mongoose;
          field.arrayTypeScript = availableDataTypes[arrayTypeIndex].typescript;
          
          if (field.arrayType === 'ObjectId') {
            field.ref = await askQuestion(rl, 'Reference model name: ');
          }
        }
      }
      
      // Field validation options
      const required = await askQuestion(rl, 'Required? (y/N): ');
      field.required = required.toLowerCase() === 'y';
      
      const unique = await askQuestion(rl, 'Unique? (y/N): ');
      field.unique = unique.toLowerCase() === 'y';
      
      const index = await askQuestion(rl, 'Create index? (y/N): ');
      field.index = index.toLowerCase() === 'y';
      
      // Type-specific validations
      if (selectedType.mongoose === 'String') {
        const minLength = await askQuestion(rl, 'Minimum length (optional): ');
        if (minLength) field.minLength = parseInt(minLength);
        
        const maxLength = await askQuestion(rl, 'Maximum length (optional): ');
        if (maxLength) field.maxLength = parseInt(maxLength);
        
        const trim = await askQuestion(rl, 'Trim whitespace? (Y/n): ');
        field.trim = trim.toLowerCase() !== 'n';
      }
      
      if (selectedType.mongoose === 'Number') {
        const min = await askQuestion(rl, 'Minimum value (optional): ');
        if (min) field.min = parseFloat(min);
        
        const max = await askQuestion(rl, 'Maximum value (optional): ');
        if (max) field.max = parseFloat(max);
      }
      
      fields.push(field);
      fieldIndex++;
      console.log('');
    }
    
    if (fields.length === 0) {
      console.log(colors.yellow('⚠️  No fields added. Model creation cancelled.'));
      rl.close();
      return;
    }
    
    // Generate TypeScript files
    const modelContent = generateTypescriptSchemaTemplate(modelName, fields);
    const serviceContent = generateTsServiceTemplate(modelName, modelName);
    const controllerContent = generateTsControllerTemplate(modelName, modelName);
    const routeContent = generateTsRouteTemplate(modelName);
    
    // Write files
    const modelPath = path.join(srcPath, 'models', `${capitalize(modelName)}.ts`);
    const servicePath = path.join(srcPath, 'services', `${toCamelCase(modelName)}Service.ts`);
    const controllerPath = path.join(srcPath, 'controllers', `${toCamelCase(modelName)}Controller.ts`);
    const routePath = path.join(srcPath, 'routes', `${toCamelCase(modelName)}.ts`);
    
    await fs.writeFile(modelPath, modelContent);
    await fs.writeFile(servicePath, serviceContent);
    await fs.writeFile(controllerPath, controllerContent);
    await fs.writeFile(routePath, routeContent);
    
    // Update schema registry
    await updateSchemaRegistry(currentPath, modelName);
    
    // Update route index
    await updateRouteIndex(currentPath, modelName);
    
    console.log(colors.green(`✅ Created TypeScript model: ${capitalize(modelName)}`));
    console.log(colors.green(`✅ Created service: ${toCamelCase(modelName)}Service.ts`));
    console.log(colors.green(`✅ Created controller: ${toCamelCase(modelName)}Controller.ts`));
    console.log(colors.green(`✅ Created routes: ${toCamelCase(modelName)}.ts`));
    console.log(colors.green(`✅ Updated schema registry`));
    console.log(colors.green(`✅ Updated route index`));
    
    rl.close();
  } catch (error) {
    rl.close();
    throw error;
  }
};

