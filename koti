// TypeScript template generators for enhanced CLI
const generateTypescriptSchemaTemplate = (modelName, fields) => {
  const modelNameCap = capitalize(modelName);
  const modelNameLower = modelName.toLowerCase();
  const schemaFields = generateTypescriptSchemaFields(fields);
  const interfaceFields = generateTypescriptInterface(fields);
  const joiValidation = generateJoiValidationSchema(fields);
  const swaggerDoc = generateSwaggerModelDoc(modelNameCap, fields);

  return `import mongoose, { Document, Schema, Types } from 'mongoose';
import Joi from 'joi';

// Interface for the ${modelNameCap} document
export interface I${modelNameCap} extends Document {
${interfaceFields}
  createdAt: Date;
  updatedAt: Date;
}

// Create Interface (without timestamps)
export interface I${modelNameCap}Create {
${interfaceFields}
}

// Update Interface (all fields optional)
export interface I${modelNameCap}Update {
${interfaceFields.replace(/: /g, '?: ')}
}

${joiValidation}

${swaggerDoc}

// Schema definition
const ${modelNameCap}Schema: Schema<I${modelNameCap}> = new Schema({
${schemaFields}
}, {
  timestamps: true,
  toJSON: { virtuals: true },
  toObject: { virtuals: true }
});

// Indexes
${modelNameCap}Schema.index({ createdAt: -1 });
${fields.filter(f => f.index).map(f => `${modelNameCap}Schema.index({ ${f.name}: 1 });`).join('\n')}

// Virtual for ID
${modelNameCap}Schema.virtual('id').get(function() {
  return this._id.toHexString();
});

// Instance method to return public data
${modelNameCap}Schema.methods.toPublicJSON = function() {
  const publicData = this.toObject();
  delete publicData.__v;
  return publicData;
};

// Static method to find active records
${modelNameCap}Schema.statics.findActive = function() {
  return this.find({ active: { $ne: false } });
};

// Static method for paginated search
${modelNameCap}Schema.statics.paginate = function(filter = {}, options = {}) {
  const page = parseInt(options.page) || 1;
  const limit = parseInt(options.limit) || 10;
  const skip = (page - 1) * limit;
  const sort = options.sort || { createdAt: -1 };

  return Promise.all([
    this.find(filter).skip(skip).limit(limit).sort(sort),
    this.countDocuments(filter)
  ]).then(([docs, total]) => ({
    docs,
    total,
    page,
    pages: Math.ceil(total / limit),
    limit,
    hasNext: page < Math.ceil(total / limit),
    hasPrev: page > 1
  }));
};

export default mongoose.model<I${modelNameCap}>('${modelNameCap}', ${modelNameCap}Schema);`;
};

// Generate Joi validation schema
const generateJoiValidationSchema = (fields) => {
  let joiFields = '';
  
  fields.forEach(field => {
    let joiDef = `  ${field.name}: `;
    
    switch (field.type) {
      case 'String':
        joiDef += 'Joi.string()';
        if (field.minLength) joiDef += `.min(${field.minLength})`;
        if (field.maxLength) joiDef += `.max(${field.maxLength})`;
        if (field.trim) joiDef += '.trim()';
        break;
      case 'Number':
        joiDef += 'Joi.number()';
        if (field.min !== undefined) joiDef += `.min(${field.min})`;
        if (field.max !== undefined) joiDef += `.max(${field.max})`;
        break;
      case 'Boolean':
        joiDef += 'Joi.boolean()';
        break;
      case 'Date':
        joiDef += 'Joi.date()';
        break;
      case 'ObjectId':
        joiDef += 'Joi.string().regex(/^[0-9a-fA-F]{24}$/).messages({ "string.pattern.base": "Invalid ObjectId format" })';
        break;
      case 'Array':
        if (field.arrayType === 'ObjectId') {
          joiDef += 'Joi.array().items(Joi.string().regex(/^[0-9a-fA-F]{24}$/))';
        } else if (field.arrayType === 'String') {
          joiDef += 'Joi.array().items(Joi.string())';
        } else if (field.arrayType === 'Number') {
          joiDef += 'Joi.array().items(Joi.number())';
        } else {
          joiDef += 'Joi.array()';
        }
        break;
      default:
        joiDef += 'Joi.any()';
    }
    
    if (field.required) {
      joiDef += '.required()';
    } else {
      joiDef += '.optional()';
    }
    
    joiFields += `${joiDef},\n`;
  });

  return `// Joi Validation Schemas
export const createValidationSchema = Joi.object({
${joiFields}});

export const updateValidationSchema = Joi.object({
${joiFields.replace(/\.required\(\)/g, '.optional()')}}).min(1);

export const queryValidationSchema = Joi.object({
  page: Joi.number().min(1).default(1),
  limit: Joi.number().min(1).max(100).default(10),
  sort: Joi.string().default('createdAt'),
  order: Joi.string().valid('asc', 'desc').default('desc'),
  q: Joi.string().allow('').optional()
});`;
};

// Generate Swagger documentation
const generateSwaggerModelDoc = (modelName, fields) => {
  let swaggerProperties = '';
  let requiredFields = [];
  
  fields.forEach(field => {
    let propDef = `    ${field.name}:\n      type: `;
    
    switch (field.type) {
      case 'String':
        propDef += 'string';
        if (field.minLength) propDef += `\n      minLength: ${field.minLength}`;
        if (field.maxLength) propDef += `\n      maxLength: ${field.maxLength}`;
        break;
      case 'Number':
        propDef += 'number';
        if (field.min !== undefined) propDef += `\n      minimum: ${field.min}`;
        if (field.max !== undefined) propDef += `\n      maximum: ${field.max}`;
        break;
      case 'Boolean':
        propDef += 'boolean';
        break;
      case 'Date':
        propDef += 'string\n      format: date-time';
        break;
      case 'ObjectId':
        propDef += 'string\n      pattern: "^[0-9a-fA-F]{24}$"\n      example: "507f1f77bcf86cd799439011"';
        break;
      case 'Array':
        propDef += 'array\n      items:\n        type: ';
        if (field.arrayType === 'ObjectId') {
          propDef += 'string\n        pattern: "^[0-9a-fA-F]{24}$"';
        } else {
